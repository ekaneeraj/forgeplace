{
  "name": "forgeplace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "ui",
    "api"
  ],
  "scripts": {
    "dev": "bun run ui & bun run api",
    "ui": "bun run --filter ui dev",
    "api": "bun run --filter api start:dev",
    "build": "bun run --filter api build",
    "build:ui": "bun run --filter ui build",
    "lint": "bun run --filter api lint",
    "lint:ui": "bun run --filter ui lint",
    "test": "bun run --filter api test",
    "test:ui": "bun run --filter ui test",
    "clean": "rm -rf node_modules ui/node_modules api/node_modules ui/.next api/dist"
  }
}
